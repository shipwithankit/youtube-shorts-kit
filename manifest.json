{
  "manifest_version": 3,
  "name": "Shorts Kit – Transcript, Tags, Stats & AI Rewrite",
  "version": "2.0.0",
  "description": "One click on any YouTube Short: transcript, Studio tags, views/day, outlier score, hook, a research library and Gemini rewrites.",
  "homepage_url": "https://github.com/Ankitmmm/youtube-shorts-kit",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Analyze this Short (or open the Library)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "library.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
